# Backend runtime configuration
# Copy this file to `backend/.env` and replace the placeholder password.
# Never commit `backend/.env`.

NODE_ENV=development
HOST=127.0.0.1
PORT=5000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# The backend runs on the Windows host, so it reaches PostgreSQL through
# the published loopback port. Inside Docker the hostname would be `postgres`.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=exchnage_dev
DB_USER=exchnage_app
DB_PASSWORD=replace_with_local_password
DB_SSL=false
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000

# Secret used to sign short-lived access tokens (HS256). Must be at least 32
# characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=replace_with_at_least_32_random_characters

# Platform configuration. Keep the brand here rather than in controllers.
PLATFORM_NAME=Exchnage
PLATFORM_CURRENCY=INR
PLATFORM_TIMEZONE=Asia/Kolkata
