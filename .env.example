# -----------------------------------------------------------------------------
# Exchnage - local Docker Compose environment
#
# 1. Copy this file to `.env`:
#      Windows PowerShell: Copy-Item .env.example .env
#      Ubuntu / macOS:     cp .env.example .env
# 2. Replace ALL placeholder values.
# 3. Never commit `.env`.
#
# This file configures Docker Compose only. The API has its own
# backend/.env; keep its DB_NAME, DB_USER, DB_PASSWORD, and DB_PORT in sync
# with the POSTGRES_* values below.
#
# Use URL-safe characters in passwords (letters, digits, "-", "_") so the
# values can also be used in a PostgreSQL connection URL later.
# -----------------------------------------------------------------------------

# Compose prefixes container and volume names with this value.
COMPOSE_PROJECT_NAME=exchnage

# PostgreSQL database server
POSTGRES_DB=exchnage_dev
POSTGRES_USER=exchnage_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432

# pgAdmin web UI (database administration only, not the database itself)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-long-random-password
PGADMIN_PORT=5050
