{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exchnage-souvik",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a4afb8c876024fbd84041b2933a8951e"
    }
  ],
  "d1_databases": [
    {
      "binding": "EXCHANGE_D1",
      "database_name": "exchange-edge-db",
      "database_id": "179e39fb-5b84-4f29-9604-02ffcd9b0a0e"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "EXCHANGE_KV",
      "id": "1696f5ff60834a79875234539dd39cd2"
    }
  ],
  // Note: To activate R2 bucket binding once enabled in Cloudflare Dashboard:
  // "r2_buckets": [
  //   {
  //     "binding": "EXCHANGE_R2",
  //     "bucket_name": "exchange-media"
  //   }
  // ],
  "queues": {
    "producers": [
      {
        "queue": "exchange-events",
        "binding": "EVENT_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "exchange-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "INVENTORY_LOCK",
        "class_name": "InventoryLockDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "InventoryLockDO"
      ]
    }
  ],
  "workflows": [
    {
      "name": "rental-lifecycle",
      "binding": "RENTAL_WORKFLOW",
      "class_name": "RentalLifecycleWorkflow"
    }
  ],
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "API_PREFIX": "/api/v1",
    "PLATFORM_NAME": "Exchnage",
    "PLATFORM_CURRENCY": "INR",
    "PLATFORM_TIMEZONE": "Asia/Kolkata",
    "TURNSTILE_SITEKEY": "0x4AAAAAAF2CZKS04qmu5moS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
