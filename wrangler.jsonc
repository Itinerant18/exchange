{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exchnage-souvik",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a4afb8c876024fbd84041b2933a8951e"
    }
  ],
  "d1_databases": [
    {
      "binding": "EXCHANGE_D1",
      "database_name": "exchange-edge-db",
      "database_id": "179e39fb-5b84-4f29-9604-02ffcd9b0a0e"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "EXCHANGE_KV",
      "id": "1696f5ff60834a79875234539dd39cd2"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "exchange-events",
        "binding": "EVENT_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "exchange-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "INVENTORY_LOCK",
        "class_name": "InventoryLockDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "InventoryLockDO"
      ]
    }
  ],
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "API_PREFIX": "/api/v1",
    "PLATFORM_NAME": "Exchnage",
    "PLATFORM_CURRENCY": "INR",
    "PLATFORM_TIMEZONE": "Asia/Kolkata",
    "AUTH_JWT_SECRET": "8e4952aca2775546fd924ece45df134ec1d71603407b66c00c1aaaa4c738e979e8d66292fe29f5b4ea6b71bb25a6b663"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
